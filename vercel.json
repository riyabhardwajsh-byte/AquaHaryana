{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/aquasave_icon.png",
      "dest": "/aquasave_icon.png"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
